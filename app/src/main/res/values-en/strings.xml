    <string name="settings_buffer">Buffer</string>
    <string name="settings_buffer_desc">A small buffer zaps faster; a large one rides out dropouts better.</string>
    <string name="buffer_low">Small (fast zapping)</string>
    <string name="buffer_normal">Normal</string>
    <string name="buffer_high">Large (unstable connection)</string>
    <string name="buffer_maximum">Largest (server with dropouts)</string>
    <string name="settings_preview">Preview in the channel list</string>
    <string name="settings_preview_desc">Plays the focused channel in the right-hand panel after a moment.</string>
    <string name="settings_resilient">Ride out server dropouts</string>
    <string name="settings_resilient_desc">If the stream breaks, reconnects on its own several times instead of erroring, and insists longer on network failures. Pair it with the largest buffer if your provider is marginal.</string>
    <string name="settings_keep_channel">Remember the last channel</string>
    <string name="settings_keep_channel_desc">Leaving a channel with BACK keeps it playing in the preview. From the list, BACK puts it back to full screen; twice in a row exits.</string>
    <string name="settings_user_agent">Default User-Agent</string>
    <string name="settings_user_agent_desc">Some providers block agents they do not know.</string>

